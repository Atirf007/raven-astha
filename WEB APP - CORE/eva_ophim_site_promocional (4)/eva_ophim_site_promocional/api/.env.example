# ─── EVAH OPHIM — Environment Variables ───

# Server
PORT=3000
HOST=127.0.0.1
# Trusted fixed analytics runners only; never enables arbitrary code or file imports.
# Requires analytics_schema.sql provisioned by the migration account and Node 24+.
ANALYTICS_TRUSTED_RUNNER=false
# CSV/JSON imports require a separate Linux container parser; no host fallback.
# Pin an approved official Node 24+ image digest, pre-pull it, then validate isolation.
ANALYTICS_FILE_IMPORTS=false
ANALYTICS_PARSER_IMAGE=
ANALYTICS_DOCKER_PATH=docker

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=astha_runtime
DB_PASSWORD=
DB_NAME=evah_ophim
# Remote databases always require verified TLS. Supply the provider CA if needed.
DB_SSL_REQUIRED=true
DB_SSL_CA_FILE=
# Explicit platform support identities; tenant admins have no global contact access.
SUPPORT_ADMIN_IDENTITIES=[]

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Optional verified OAuth providers
GOOGLE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Browser origins allowed by CORS (comma-separated; never use *)
ALLOWED_ORIGINS=http://localhost:3000
